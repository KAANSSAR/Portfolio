# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored by default in Next.js, never commit real secrets.

# --- Public (safe to expose client-side) ---------------------------------
# Supabase project URL and anon/publishable key. Reads (published blog
# posts, quant-lab overrides) go straight from the browser using these.
# That's fine by design as long as your Supabase RLS policies only allow
# public SELECT on these tables, not INSERT/UPDATE/DELETE.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (NEVER prefix these with NEXT_PUBLIC_) -------------------
# Editor password, checked in src/app/api/editor/login/route.ts. This value
# never ships to the browser. Leave unset to disable the editor entirely.
# Published content still renders, but nobody can unlock the edit UI.
BLOG_EDITOR_PASSWORD=

# Random secret used to sign the editor's session cookie (HMAC-SHA256).
# Generate one with: openssl rand -hex 32
BLOG_SESSION_SECRET=

# Supabase *service role* key, from Project Settings > API in your Supabase
# dashboard. This bypasses Row Level Security entirely, it's only ever
# used inside src/app/api/editor/* route handlers (server-side), after the
# session cookie above has already been verified. Rotate immediately if
# this value is ever exposed (committed, pasted into a chat, etc.).
SUPABASE_SERVICE_ROLE_KEY=

# --- EmailJS (Contact form) ------------------------------------------------
# Defaults in code fall back to the mockup's original IDs (a real, already-
# configured EmailJS account), so the form works out of the box. Override
# here if you set up your own.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Cube stock tickers -----------------------------------------------------
# Twelve Data API key (server-only), powers the live stock/crypto tickers on
# the Rubik's cube (src/components/ui/Cube.jsx via /api/quote). This key was
# found hardcoded in the original design files, same caution as the
# Supabase key above applies: if it's already been exposed anywhere public,
# rotate it at twelvedata.com regardless of this fix being in place.
TWELVE_DATA_API_KEY=
